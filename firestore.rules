rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write ONLY their own data:
    // users/{their UID}/data/transactions | budgets | recurring
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && docId in ['transactions', 'budgets', 'recurring'];
    }

    // Everything else stays locked (no rule = denied).
  }
}
